{
  "name": "buildright-aco-complete-project",
  "version": "2.0.0",
  "description": "BuildRight ACO catalog data management with modular utilities for ingestion and deletion",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "generate:metadata": "node scripts/generate-metadata.js",
    "generate:categories": "node scripts/generate-categories.js",
    "generate:products": "node scripts/generate-products.js",
    "generate:variants": "node scripts/generate-variants.js",
    "generate:price-books": "node scripts/prices/generate-price-books.js",
    "generate:prices": "node scripts/prices/generate-prices.js",
    "generate:eds-data": "node scripts/workflows/generate-eds-data.js",
    "generate:service-data": "node scripts/products/generate-service-data.js",
    "generate:all": "node scripts/workflows/generate-all-parallel.js",
    "generate:all:sequential": "npm run generate:metadata && npm run generate:categories && npm run generate:products && npm run generate:variants && npm run generate:price-books && npm run generate:prices && npm run generate:eds-data && npm run generate:service-data",
    "delete": "node scripts/workflows/reset-all.js",
    "delete:products": "node scripts/workflows/reset-all.js --skip-prices",
    "seed-state": "node scripts/seed-state-from-files.js",
    "import": "node scripts/workflows/ingest-all.js",
    "import:metadata": "node scripts/attributes/ingest-metadata.js",
    "import:products": "node scripts/products/ingest-products.js",
    "import:variants": "node scripts/products/ingest-variants.js",
    "import:price-books": "node scripts/prices/ingest-price-books.js",
    "import:prices": "node scripts/prices/ingest-prices.js --skip-validation",
    "validate:schema": "node scripts/tools/validate-aco-schema.js",
    "validate:ingestion": "node scripts/workflows/validate-ingestion.js",
    "fetch:catalog-views": "node scripts/tools/fetch-catalog-views.js",
    "fetch:catalog-views:json": "node scripts/tools/fetch-catalog-views.js --json",
    "fetch:catalog-views:mapping": "node scripts/tools/fetch-catalog-views.js --mapping"
  },
  "keywords": [
    "adobe-commerce",
    "aco",
    "catalog",
    "data-ingestion",
    "modular-utilities"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@adobe-commerce/aco-ts-sdk": "^1.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.6.0",
    "cli-progress": "^3.12.0",
    "dotenv": "^16.3.1",
    "ora": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    },
    "collectCoverageFrom": [
      "scripts/**/*.js",
      "!scripts/**/*.test.js",
      "utils/**/*.js",
      "!utils/**/*.test.js"
    ]
  }
}
