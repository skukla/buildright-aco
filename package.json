{
  "name": "buildright-aco-complete-project",
  "version": "2.0.0",
  "description": "BuildRight ACO catalog data management with modular utilities for ingestion and deletion",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "generate": "node scripts/workflows/generate-all-parallel.js",
    "import": "node scripts/workflows/ingest-all.js",
    "delete": "node scripts/workflows/reset-all.js"
  },
  "keywords": [
    "adobe-commerce",
    "aco",
    "catalog",
    "data-ingestion",
    "modular-utilities"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@adobe-commerce/aco-ts-sdk": "^1.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.6.0",
    "cli-progress": "^3.12.0",
    "dotenv": "^16.3.1",
    "ora": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    },
    "collectCoverageFrom": [
      "scripts/**/*.js",
      "!scripts/**/*.test.js",
      "utils/**/*.js",
      "!utils/**/*.test.js"
    ]
  }
}
