{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ACO MSI Inventory Schema",
  "description": "Schema for Adobe Commerce Open Source Multi-Source Inventory items",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "sku",
      "quantity",
      "sources"
    ],
    "properties": {
      "sku": {
        "type": "string",
        "description": "Product SKU",
        "minLength": 1,
        "maxLength": 64
      },
      "quantity": {
        "type": "integer",
        "description": "Total quantity across all sources",
        "minimum": 0
      },
      "sources": {
        "type": "array",
        "description": "Array of source-specific inventory",
        "items": {
          "type": "object",
          "required": [
            "source_code",
            "quantity"
          ],
          "properties": {
            "source_code": {
              "type": "string",
              "description": "Reference to source code",
              "pattern": "^[a-z0-9_]+$",
              "minLength": 3,
              "maxLength": 50
            },
            "quantity": {
              "type": "integer",
              "description": "Quantity available at this source",
              "minimum": 0
            },
            "status": {
              "type": "string",
              "description": "Stock status at this source",
              "enum": ["in_stock", "out_of_stock"],
              "default": "in_stock"
            },
            "notify_stock_qty": {
              "type": ["integer", "null"],
              "description": "Low stock notification threshold",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "is_in_stock": {
        "type": "boolean",
        "description": "Overall stock status",
        "default": true
      },
      "manage_stock": {
        "type": "boolean",
        "description": "Whether to manage stock for this item",
        "default": true
      },
      "use_config_manage_stock": {
        "type": "boolean",
        "description": "Use global configuration for stock management",
        "default": true
      },
      "min_qty": {
        "type": ["integer", "null"],
        "description": "Out of stock threshold",
        "default": 0
      },
      "max_sale_qty": {
        "type": ["integer", "null"],
        "description": "Maximum quantity allowed in cart",
        "default": 10000
      },
      "backorders": {
        "type": "string",
        "description": "Backorder configuration",
        "enum": ["no_backorders", "allow_qty_below_0", "allow_qty_below_0_and_notify"],
        "default": "no_backorders"
      },
      "qty_increments": {
        "type": ["integer", "null"],
        "description": "Quantity increments for ordering",
        "minimum": 1,
        "default": 1
      }
    },
    "additionalProperties": false
  },
  "minItems": 0,
  "uniqueItems": true
}