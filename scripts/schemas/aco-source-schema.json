{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ACO MSI Source Schema",
  "description": "Schema for Adobe Commerce Open Source Multi-Source Inventory (MSI) source definitions",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "source_code",
      "name",
      "country_id",
      "postcode"
    ],
    "properties": {
      "source_code": {
        "type": "string",
        "description": "Unique identifier for the source",
        "pattern": "^[a-z0-9_]+$",
        "minLength": 3,
        "maxLength": 50
      },
      "name": {
        "type": "string",
        "description": "Display name for the source",
        "minLength": 3,
        "maxLength": 100
      },
      "country_id": {
        "type": "string",
        "description": "ISO 3166-1 alpha-2 country code",
        "pattern": "^[A-Z]{2}$"
      },
      "postcode": {
        "type": "string",
        "description": "Postal code of the source location",
        "minLength": 1,
        "maxLength": 20
      },
      "enabled": {
        "type": "boolean",
        "description": "Whether the source is active"
      },
      "region": {
        "type": ["string", "null"],
        "description": "Region/area designation",
        "maxLength": 100
      },
      "city": {
        "type": ["string", "null"],
        "description": "City name",
        "maxLength": 100
      },
      "region_id": {
        "type": ["integer", "null"],
        "description": "ACO region ID"
      },
      "latitude": {
        "type": ["number", "null"],
        "description": "Geographic latitude",
        "minimum": -90,
        "maximum": 90
      },
      "longitude": {
        "type": ["number", "null"],
        "description": "Geographic longitude",
        "minimum": -180,
        "maximum": 180
      },
      "description": {
        "type": ["string", "null"],
        "description": "Detailed description of the source",
        "maxLength": 500
      },
      "contact_name": {
        "type": ["string", "null"],
        "description": "Contact person or department",
        "maxLength": 100
      },
      "email": {
        "type": ["string", "null"],
        "description": "Contact email address",
        "format": "email"
      },
      "phone": {
        "type": ["string", "null"],
        "description": "Contact phone number",
        "maxLength": 50
      }
    },
    "additionalProperties": false
  },
  "minItems": 1,
  "uniqueItems": true
}