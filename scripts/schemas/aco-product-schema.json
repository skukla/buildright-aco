{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ACO Product Schema",
  "description": "Schema for Adobe Commerce Order product structure",
  "type": "object",
  "required": [
    "sku",
    "name",
    "type",
    "status",
    "visibility",
    "price",
    "attributes",
    "routes"
  ],
  "properties": {
    "sku": {
      "type": "string",
      "pattern": "^[A-Z0-9\\-\\.]+$",
      "minLength": 1,
      "maxLength": 64,
      "description": "Stock Keeping Unit"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Product name"
    },
    "type": {
      "type": "string",
      "enum": ["simple", "configurable", "bundle", "service"],
      "description": "Product type"
    },
    "status": {
      "type": "string",
      "enum": ["enabled", "disabled"],
      "description": "Product status"
    },
    "visibility": {
      "type": "string",
      "enum": ["catalog", "search", "both", "none"],
      "description": "Product visibility settings"
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "description": "Product price"
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "value"],
        "properties": {
          "code": {
            "type": "string",
            "description": "Attribute code from metadata"
          },
          "value": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "array" }
            ],
            "description": "Attribute value"
          }
        }
      },
      "description": "Product attributes"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["categoryId"],
        "properties": {
          "categoryId": {
            "type": "string",
            "description": "Category ID reference"
          },
          "position": {
            "type": "number",
            "description": "Position in category"
          }
        }
      },
      "description": "Category assignments"
    },
    "parentSku": {
      "type": "string",
      "pattern": "^[A-Z0-9\\-\\.]+$",
      "description": "Parent SKU for variants"
    },
    "configurationDimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attribute", "values"],
        "properties": {
          "attribute": {
            "type": "string",
            "description": "Configuration attribute code"
          },
          "values": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "number" }
              ]
            },
            "description": "Possible values for this dimension"
          }
        }
      },
      "description": "Configuration dimensions for configurable products"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "required", "multiSelect", "items"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Group name"
          },
          "required": {
            "type": "boolean",
            "description": "Whether group selection is required"
          },
          "multiSelect": {
            "type": "boolean",
            "description": "Whether multiple items can be selected"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["sku", "defaultQty"],
              "properties": {
                "sku": {
                  "type": "string",
                  "pattern": "^[A-Z0-9\\-\\.]+$",
                  "description": "Item SKU"
                },
                "defaultQty": {
                  "type": "number",
                  "minimum": 1,
                  "description": "Default quantity"
                }
              }
            },
            "description": "Items in group"
          }
        }
      },
      "description": "Bundle groups (for bundle products only)"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "shortDescription": {
      "type": "string",
      "description": "Short product description"
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "description": "Product weight"
    },
    "metaTitle": {
      "type": "string",
      "description": "Meta title for SEO"
    },
    "metaDescription": {
      "type": "string",
      "description": "Meta description for SEO"
    },
    "metaKeywords": {
      "type": "string",
      "description": "Meta keywords for SEO"
    }
  },
  "additionalProperties": false
}