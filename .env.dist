# ============================================
# Adobe Commerce Optimizer (ACO) Configuration
# ============================================
#
# Copy this file to .env and fill in your actual values.
# Get credentials from:
# - Adobe Developer Console: CLIENT_ID, CLIENT_SECRET
# - Commerce Cloud Manager: TENANT_ID, REGION, ENVIRONMENT
#
# Documentation: https://github.com/adobe-commerce/aco-ts-sdk

# ============================================
# Authentication (from Adobe Developer Console)
# ============================================

# Client ID from Adobe IMS Integration
CLIENT_ID=your-client-id-here

# Client Secret from Adobe IMS Integration
CLIENT_SECRET=your-client-secret-here

# ============================================
# Instance Configuration (from Commerce Cloud Manager)
# ============================================

# Tenant ID (unique identifier for your ACO instance)
# Find in Commerce Cloud Manager > Instance Details
TENANT_ID=your-tenant-id-here

# Region where your ACO instance is deployed
# Common values: na1 (North America)
REGION=na1

# Environment type
# Valid values: sandbox, production
ENVIRONMENT=sandbox

# ============================================
# Optional SDK Configuration
# ============================================

# HTTP request timeout in milliseconds
# Default: 10000 (10 seconds)
TIMEOUT_MS=10000

# Logging level for SDK operations
# Valid values: DEBUG, INFO, WARN, ERROR
# Default: INFO
LOG_LEVEL=INFO

# ============================================
# GraphQL Query Configuration
# ============================================
# These are used as HTTP headers for GraphQL queries
# Not part of SDK configuration

# Catalog View ID for GraphQL queries
# Default: "default"
VIEW_ID=default

# Source locale for data filtering
# Common values: en-US, en-GB, fr-FR, de-DE
SOURCE_LOCALE=en-US

# ============================================
# Data Generation Configuration
# ============================================

# Seed for deterministic random data generation
# Use same seed to get identical output across runs
# Default: Uses current timestamp if not set
SEED=12345

# ============================================
# Endpoint Reference (Auto-constructed by SDK)
# ============================================
# Do NOT add these to .env - they are constructed automatically:
#
# REST API (Data Ingestion):
#   Sandbox:    https://na1-sandbox.api.commerce.adobe.com/{tenantId}/v1/catalog
#   Production: https://na1.api.commerce.adobe.com/{tenantId}/v1/catalog
#
# GraphQL API (Queries):
#   Sandbox:    https://na1-sandbox.api.commerce.adobe.com/{tenantId}/graphql
#   Production: https://na1.api.commerce.adobe.com/{tenantId}/graphql
#
# UI Access:
#   https://experience.adobe.com/#/@demosystem/in:{tenantId}/commerce-optimizer-studio
# ============================================
